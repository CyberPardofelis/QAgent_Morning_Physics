      "prompt": "在 Lean 4 中证明：对任意自然数 n，sum_{k=0}^{n} k = n(n+1)/2。",
      "tool_hints": "使用 lean_check，可参考 Mathlib 的 Finset.sum_range",
      "ground_truth": {
        "statement": "Finset.sum (Finset.range (n+1)) (fun k => k) = n*(n+1)/2",
