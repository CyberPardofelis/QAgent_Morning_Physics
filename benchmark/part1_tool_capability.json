      "ground_truth": {
        "statement": "1 + 1 = 2 : Nat",
        "proof_sketch": "rfl 或 norm_num"
      },
      "verifier": {
        "entrypoint": "verifiers/part1/lean_01.py",
        "pass_condition": "lean exits 0 and no sorry"
      },
      "difficulty": "trivial",
      "notes": "基础通道测试，确保 Lean 能启动并返回。"
    },
